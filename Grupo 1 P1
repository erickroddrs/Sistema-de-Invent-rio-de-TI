programa
{
    inteiro opcao
    cadeia ativos[3]
    inteiro estoque[3][2]   // coluna 0 = atual, coluna 1 = minima

    funcao inicio()
    {
        ativos[0] = "Notebooks"
        ativos[1] = "Monitores"
        ativos[2] = "Teclados"

        estoque[0][0] = 10   // Notebooks: atual
        estoque[0][1] = 5    // Notebooks: minima
        estoque[1][0] = 3    // Monitores: atual (abaixo do minimo)
        estoque[1][1] = 8    // Monitores: minima
        estoque[2][0] = 20   // Teclados: atual
        estoque[2][1] = 10   // Teclados: minima

        opcao = 0

        enquanto (opcao != 3)
        {
            escreva("\n")
            escreva("=== SISTEMA DE INVENTARIO DE TI ===\n")
            escreva("1 - Emitir Relatorio\n")
            escreva("2 - Registrar Recebimento\n")
            escreva("3 - Encerrar Sistema\n")
            escreva("Escolha uma opcao: ")
            leia(opcao)

            escolha(opcao)
            {
                caso 1:
                    escreva("Logica do relatorio entrara aqui\n")
                    pare

                caso 2:
                    escreva("Logica de recebimento entrara aqui\n")
                    pare

                caso 3:
                    escreva("Encerrando o sistema...\n")
                    pare

                caso contrario:
                    escreva("Opcao invalida! Tente novamente.\n")
            }
        }
    }
}
